# Neon Postgres connection string (sqlite:///./dev.db works for local dev)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string used to sign login cookies
SECRET_KEY=change-me-to-a-long-random-string
# "production" turns on Secure cookies
APP_ENV=development
# Initial admin created by `python -m backend.seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Hosted Judge0 CE
JUDGE0_URL=https://ce.judge0.com
# Optional: only if your Judge0 host needs a token
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
